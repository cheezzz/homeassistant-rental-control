{
  // Python interpreter - use the venv
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Testing configuration
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests",
    "--ignore=tests/test_real_calendars.py"
  ],

  // Linting (ruff is used via pre-commit)
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,

  // Formatting (ruff is used via pre-commit)
  "editor.formatOnSave": false,

  // Type checking
  "python.analysis.typeCheckingMode": "basic",

  // Auto-activate venv when opening terminal
  "python.terminal.activateEnvironment": true,

  // Exclude patterns for file explorer
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/htmlcov": true,
    "**/*.pyc": true
  },

  // Exclude patterns for search
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/htmlcov": true,
    "**/.venv": true
  }
}
